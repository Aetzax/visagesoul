<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>VisageSoul Project</vendor>
  <vendor_url>https://github.com/visagesoul/visagesoul</vendor_url>
  <icon_name>camera-web</icon_name>

  <action id="org.visagesoul.manage-pam">
    <description>Configurar inicio de sesión biométrico con VisageSoul</description>
    <message>Se requiere autenticación de administrador para modificar las reglas de inicio de sesión (PAM) o registrar perfiles faciales en VisageSoul</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/visagesoul</annotate>
  </action>
</policyconfig>
